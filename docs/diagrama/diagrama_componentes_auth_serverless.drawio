        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\n    subgraph CLIENTE[\&quot;Cliente / Front-end\&quot;]\n        USER[\&quot;Usuario / Sistema&lt;br/&gt;consumidor\&quot;]\n    end\n\n    subgraph BORDA[\&quot;Borda publica\&quot;]\n        APIGW[\&quot;API Gateway HTTP API&lt;br/&gt;(unica borda publica)\&quot;]\n    end\n\n    subgraph VPC[\&quot;VPC — workshop-infra-kubernetes\&quot;]\n        VPCLINK[\&quot;VPC Link\&quot;]\n        NLB[\&quot;NLB interno&lt;br/&gt;workshop-api-internal&lt;br/&gt;(sem exposicao publica)\&quot;]\n\n        subgraph EKS[\&quot;EKS workshop-eks\&quot;]\n            SVC[\&quot;Service (ClusterIP/NLB target)\&quot;]\n            APP[\&quot;workshop-service (Spring Boot)&lt;br/&gt;HPA 2 a 10 replicas&lt;br/&gt;Deployments/ConfigMaps/Secrets\&quot;]\n            NRDOT[\&quot;NRDOT collector&lt;br/&gt;(namespace newrelic)\&quot;]\n        end\n\n        RDS[(\&quot;RDS PostgreSQL&lt;br/&gt;workshop-db&lt;br/&gt;subnets privadas\&quot;)]\n    end\n\n    subgraph AUTH[\&quot;workshop-auth-serverless\&quot;]\n        LAMBDA[\&quot;Lambda Java 21&lt;br/&gt;workshop-auth-cpf&lt;br/&gt;(LabRole, VPC privada,&lt;br/&gt;alias prod, timeout 20s, 1024MB)\&quot;]\n    end\n\n    subgraph CW[\&quot;CloudWatch (fronteira AWS Academy)\&quot;]\n        CWLOG[\&quot;/aws/lambda/workshop-auth-cpf\&quot;]\n        CWACCESS[\&quot;Access logs do API Gateway&lt;br/&gt;(sem body/CPF/token)\&quot;]\n    end\n\n    subgraph OBS[\&quot;Observabilidade — New Relic US (OTLP)\&quot;]\n        NR[\&quot;New Relic&lt;br/&gt;6 dashboards + alerta G5\&quot;]\n    end\n\n    USER --&gt;|\&quot;POST /api/auth/cpf {cpf}\&quot;| APIGW\n    USER --&gt;|\&quot;Authorization: Bearer&lt;br/&gt;POST /api/v1/ordens-servico\&quot;| APIGW\n    APIGW --&gt;|\&quot;200 accessToken / 401 / 422\&quot;| USER\n\n    APIGW --&gt;|\&quot;rota $default\&quot;| VPCLINK\n    VPCLINK --&gt; NLB\n    NLB --&gt; SVC\n    SVC --&gt; APP\n\n    APIGW --&gt;|\&quot;invoke\&quot;| LAMBDA\n    LAMBDA --&gt;|\&quot;emite access token HS256&lt;br/&gt;(iss=workshop-auth,&lt;br/&gt;aud=workshop-service)\&quot;| APIGW\n\n    LAMBDA --&gt;|\&quot;consulta cliente ativo + usuario&lt;br/&gt;(db_client_sg_id)\&quot;| RDS\n    APP --&gt;|\&quot;valida assinatura/iss/aud,&lt;br/&gt;carrega usuario+roles (RBAC)\&quot;| RDS\n\n    LAMBDA -.-&gt;|\&quot;logs JSON + trace ADOT\&quot;| CWLOG\n    APIGW -.-&gt; CWACCESS\n\n    APP -.-&gt;|\&quot;trace HTTP + span JDBC&lt;br/&gt;Java Agent OTel\&quot;| NR\n    NRDOT -.-&gt;|\&quot;CPU, memoria, pods, HPA\&quot;| NR\n    LAMBDA -.-&gt;|\&quot;trace + metricas&lt;br/&gt;workshop.auth.cpf.*\&quot;| NR\n    CWACCESS -.-&gt;|\&quot;se permissoes do Academy&lt;br/&gt;permitirem\&quot;| NR\n\n    classDef box fill:#e8e4fa,stroke:#8b7fd4,color:#000\n    classDef edge fill:#fdf3e3,stroke:#d4a96a,color:#000\n    classDef nr fill:#fde5f0,stroke:#d46a9a,color:#000\n    classDef db fill:#d9f5f0,stroke:#5aa89c,color:#000\n\n    class USER,VPCLINK,NLB,SVC,APP,NRDOT,LAMBDA,CWLOG,CWACCESS box\n    class APIGW edge\n    class NR nr\n    class RDS db&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rMPwOr3m1UAe0QjO8odo-2">
